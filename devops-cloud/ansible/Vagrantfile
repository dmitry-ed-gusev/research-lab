# - useful global constants
VG_API_VERSION = "2"
VG_JSON_VLAB = "./.vagrant-data/vms-vlab-config.json"
VG_JSON_VLAB_SMALL = "./.vagrant-data/vms-vlab-small-config.json"
VG_JSON_VLAB_SAMPLE = "./.vagrant-data/vms-sample-config.json"
VG_PROVIDER_VBOX = "virtualbox"
VG_PROVIDER_LVIRT = "libvirt"
VG_DEFAULT_BOX_NAME = "server/fedora-cloud37-vbox"
# VG_DEFAULT_BOX_NAME = "server/fedora-cloud43-vbox"

# --- GROUP 1 DEFINITIONS ---
WEB_SERVERS = [
  { name: "web-01", ip: "192.168.56.11" },
  { name: "web-02", ip: "192.168.56.12" }
]

# --- GROUP 2 DEFINITIONS ---
APP_SERVERS = [
  { name: "app-01", ip: "192.168.56.21" },
  { name: "app-02", ip: "192.168.56.22" }
]

Vagrant.configure(VG_API_VERSION) do |config|

  # Используем официальный актуальный образ Fedora Cloud - global fallback config
  config.vm.box = "fedora/40-cloud-base"
  # config.vm.box = "ubuntu/focal64"

  # =========================================================================
  # GROUP 1: Web Servers
  # =========================================================================
  WEB_SERVERS.each do |server|
    config.vm.define server[:name] do |web|
      web.vm.network "private_network", ip: server[:ip]
      web.vm.provider VG_PROVIDER_VBOX do |vb|
        vb.memory = "1024"
        vb.name = server[:name]
      end
    end
  end

  # Конфигурируем 5 виртуальных машин в цикле
  (1..5).each do |i|
    config.vm.define "fedora-node-#{i}" do |node|
      
      # Задаем уникальное имя внутри операционной системы
      node.vm.hostname = "fedora-node-#{i}.local"
      
      # Выделяем статические IP-адреса в изолированной приватной сети
      # Машины получат IP: 192.168.56.11, 192.168.56.12, ..., 192.168.56.15
      node.vm.network "private_network", ip: "192.168.56.#{10 + i}"
      # Настройки аппаратных ресурсов для VirtualBox
      node.vm.provider "virtualbox" do |vb|
        vb.name = "Fedora-Node-#{i}" # Имя ВМ в интерфейсе VirtualBox
        vb.memory = "2048"           # Оперативная память (2 ГБ на каждую ВМ)
        vb.cpus = 2                  # Количество процессорных ядер
        
        # Отключаем GUI (графический интерфейс), машины работают в фоне
        vb.gui = false
        
        # Оптимизация сети VirtualBox для избежания проблем с производительностью
        vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      end

      # Базовая автоматизация: обновление пакетов при первом запуске (по желанию)
      # node.vm.provision "shell", inline: "sudo dnf update -y"
    end
  end
end


